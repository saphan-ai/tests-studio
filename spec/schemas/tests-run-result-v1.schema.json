{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tests.run-result/v1",
  "title": "Tests Studio run result, version 1",
  "description": "The document that closes a test run (spec/TEST_RUNNER_V1.md, section 'The run result'). The fields run_id, test_run_id, verdict, counts, started_at, ended_at and events_digest are the ones the ecosystem contract names; the rest is what an adapter needs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "test_run_id", "project", "verdict", "counts", "started_at", "ended_at", "events_digest", "adapter", "evidence_line"],
  "properties": {
    "schema": { "const": "tests.run-result/v1" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "test_run_id": { "$ref": "#/$defs/run_id" },
    "project": { "type": "string", "minLength": 1, "maxLength": 128 },
    "verdict": { "enum": ["pass", "fail", "error"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "errored", "skipped"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "errored": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "ended_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "events_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "spec"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "spec": { "type": "string", "pattern": "^v[0-9]+$" }
      }
    },
    "evidence_line": {
      "type": "string",
      "pattern": "^- evidence: tests-studio-run [a-z0-9][a-z0-9._-]{2,63}/[a-z0-9][a-z0-9._-]{2,63} verdict=(pass|fail|error) events=sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" }
  }
}
